{
  "name": "@evertranscript/client",
  "private": true,
  "version": "0.1.0",
  "license": "Apache-2.0",
  "description": "The EverTranscript Electron Client — a thin surface over the Core protocol.",
  "main": "dist/main/index.js",
  "scripts": {
    "protocol:sync": "node scripts/sync-protocol.mjs",
    "pretypecheck": "pnpm protocol:sync && pnpm check:translations",
    "typecheck": "tsc --noEmit -p tsconfig.json && tsc --noEmit -p tsconfig.main.json",
    "prebuild": "pnpm protocol:sync",
    "build": "vite build && tsc -p tsconfig.main.json",
    "predev": "pnpm protocol:sync",
    "dev": "vite",
    "start": "pnpm build && electron .",
    "check:translations": "node scripts/check-translations.mjs",
    "package": "pnpm build && electron-builder --publish never",
    "test": "tsc -p tsconfig.test.json && node --test \"dist-test/main/*.test.js\""
  },
  "dependencies": {
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "electron-updater": "^6.6.0"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^24.0.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^5.0.0",
    "electron": "^38.0.0",
    "tailwindcss": "^4.3.3",
    "typescript": "^5.9.0",
    "vite": "^7.0.0",
    "electron-builder": "^26.0.0"
  },
  "build": {
    "appId": "com.evertranscript.client",
    "productName": "EverTranscript",
    "directories": {
      "output": "../../packaging/out/installers",
      "buildResources": "resources"
    },
    "files": [
      "dist/**/*",
      "package.json"
    ],
    "mac": {
      "category": "public.app-category.productivity",
      "entitlements": "../../packaging/macos/entitlements.plist",
      "entitlementsInherit": "../../packaging/macos/entitlements.plist",
      "hardenedRuntime": true,
      "gatekeeperAssess": false,
      "target": [
        {
          "target": "zip",
          "arch": [
            "arm64"
          ]
        }
      ],
      "extraResources": [
        {
          "from": "../../packaging/out/evertranscript",
          "to": "evertranscript"
        },
        {
          "from": "../../packaging/out/evertranscript-summarizer",
          "to": "evertranscript-summarizer"
        }
      ]
    },
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "extraResources": [
        {
          "from": "../../packaging/out/evertranscript.exe",
          "to": "evertranscript.exe"
        },
        {
          "from": "../../packaging/out/evertranscript-summarizer.exe",
          "to": "evertranscript-summarizer.exe"
        }
      ]
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "deleteAppDataOnUninstall": false
    },
    "publish": [
      {
        "provider": "github",
        "owner": "EverTranscript",
        "repo": "EverTranscript"
      }
    ]
  }
}
