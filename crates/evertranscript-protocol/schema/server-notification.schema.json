{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "ServerNotification",
  "description": "Everything the Core may push to an attached Client unprompted.",
  "oneOf": [
    {
      "description": "The Core's coarse state changed (idle ↔ recording).",
      "type": "object",
      "properties": {
        "method": {
          "type": "string",
          "const": "core/stateChanged"
        },
        "params": {
          "$ref": "#/$defs/CoreStateChangedParams"
        }
      },
      "required": [
        "method",
        "params"
      ]
    },
    {
      "description": "A Meeting was created, updated, or removed. Clients refresh from it\nrather than polling.",
      "type": "object",
      "properties": {
        "method": {
          "type": "string",
          "const": "meeting/changed"
        },
        "params": {
          "$ref": "#/$defs/MeetingChangedParams"
        }
      },
      "required": [
        "method",
        "params"
      ]
    },
    {
      "description": "A new Transcript segment. Delivered only to subscribed connections,\nand delivered lossily: a Client that falls behind loses captions\nrather than slowing capture or being disconnected (ADR-0028).",
      "type": "object",
      "properties": {
        "method": {
          "type": "string",
          "const": "transcript/segmentAdded"
        },
        "params": {
          "$ref": "#/$defs/TranscriptSegmentAddedParams"
        }
      },
      "required": [
        "method",
        "params"
      ]
    },
    {
      "description": "Some captions were dropped because this connection was too slow.\nSent so a Client can show a gap rather than silently missing words.",
      "type": "object",
      "properties": {
        "method": {
          "type": "string",
          "const": "transcript/captionsDropped"
        },
        "params": {
          "$ref": "#/$defs/TranscriptCaptionsDroppedParams"
        }
      },
      "required": [
        "method",
        "params"
      ]
    }
  ],
  "$defs": {
    "AudioChannel": {
      "description": "Which capture leg a segment came from. The mic channel is where the\nOperator is (ADR-0029 as amended).",
      "type": "string",
      "enum": [
        "mic",
        "system"
      ]
    },
    "CoreState": {
      "description": "The Core's coarse, observable state.",
      "type": "string",
      "enum": [
        "idle",
        "recording"
      ]
    },
    "CoreStateChangedParams": {
      "type": "object",
      "properties": {
        "state": {
          "$ref": "#/$defs/CoreState"
        }
      },
      "required": [
        "state"
      ]
    },
    "Meeting": {
      "description": "One recorded session: the unit of storage, retrieval, and summary.",
      "type": "object",
      "properties": {
        "audioNotes": {
          "description": "What this recording lost, in the Operator's terms — a capture leg that\nnever started, one that died partway, audio that would not encode.\n\nEmpty for a whole recording. This is in the record rather than only in\na log because a Meeting missing half its audio is otherwise\nindistinguishable from one where nobody spoke, and the Operator finds\nout by reading a transcript that makes no sense.",
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "audioPath": {
          "type": [
            "string",
            "null"
          ]
        },
        "calendarAttendees": {
          "description": "Who the event invited. **Stored, not applied**: these become\nSpeaker-naming suggestions in M3, and turning an invitation into an\nattribution before Diarization exists would be inventing who spoke.",
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "calendarEventId": {
          "description": "The calendar event this Meeting was armed from, when one named it\n(ADR-0036). Kept so the record can say *which* scheduled meeting\nthis was, not merely that it had a title.",
          "type": [
            "string",
            "null"
          ]
        },
        "detectedApp": {
          "description": "The app detection attributed this Meeting to; the Mirror's slug\nbefore a Title exists.",
          "type": [
            "string",
            "null"
          ]
        },
        "durationSeconds": {
          "type": [
            "integer",
            "null"
          ],
          "format": "uint64",
          "minimum": 0
        },
        "endedAt": {
          "type": [
            "string",
            "null"
          ]
        },
        "id": {
          "description": "UUIDv7. Its first 8 hex characters appear in the Mirror's filename\nand are the stable handle outside references should key on.",
          "type": "string"
        },
        "mirrorFilename": {
          "type": [
            "string",
            "null"
          ]
        },
        "startedAt": {
          "type": "string"
        },
        "title": {
          "description": "None until titled. Clients render the fallback rather than inventing\na title, so \"untitled\" never becomes a stored string.",
          "type": [
            "string",
            "null"
          ]
        }
      },
      "required": [
        "id",
        "startedAt"
      ]
    },
    "MeetingChangeKind": {
      "description": "What happened to a Meeting.",
      "type": "string",
      "enum": [
        "started",
        "updated",
        "stopped",
        "deleted"
      ]
    },
    "MeetingChangedParams": {
      "type": "object",
      "properties": {
        "kind": {
          "$ref": "#/$defs/MeetingChangeKind"
        },
        "meeting": {
          "description": "Absent for a deletion.",
          "anyOf": [
            {
              "$ref": "#/$defs/Meeting"
            },
            {
              "type": "null"
            }
          ]
        },
        "meetingId": {
          "type": "string"
        }
      },
      "required": [
        "kind",
        "meetingId"
      ]
    },
    "TranscriptCaptionsDroppedParams": {
      "type": "object",
      "properties": {
        "dropped": {
          "type": "integer",
          "format": "uint32",
          "minimum": 0
        },
        "meetingId": {
          "type": "string"
        }
      },
      "required": [
        "meetingId",
        "dropped"
      ]
    },
    "TranscriptSegment": {
      "description": "One attributed span of the Transcript.",
      "type": "object",
      "properties": {
        "channel": {
          "$ref": "#/$defs/AudioChannel"
        },
        "endMs": {
          "type": "integer",
          "format": "int64"
        },
        "id": {
          "type": "string"
        },
        "sequence": {
          "type": "integer",
          "format": "int64"
        },
        "speakerId": {
          "description": "Set by Diarization in M3. Until then the channel carries attribution.",
          "type": [
            "string",
            "null"
          ]
        },
        "startMs": {
          "type": "integer",
          "format": "int64"
        },
        "text": {
          "type": "string"
        }
      },
      "required": [
        "id",
        "sequence",
        "channel",
        "startMs",
        "endMs",
        "text"
      ]
    },
    "TranscriptSegmentAddedParams": {
      "type": "object",
      "properties": {
        "meetingId": {
          "type": "string"
        },
        "segment": {
          "$ref": "#/$defs/TranscriptSegment"
        }
      },
      "required": [
        "meetingId",
        "segment"
      ]
    }
  }
}
