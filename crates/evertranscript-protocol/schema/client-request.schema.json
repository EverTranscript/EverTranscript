{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "ClientRequest",
  "description": "Every request a Client may send the Core.",
  "oneOf": [
    {
      "description": "Opens the connection. Must be the first request; every other request\nbefore it is refused with `NOT_INITIALIZED`.",
      "type": "object",
      "properties": {
        "method": {
          "type": "string",
          "const": "initialize"
        },
        "params": {
          "$ref": "#/$defs/InitializeParams"
        }
      },
      "required": [
        "method",
        "params"
      ]
    },
    {
      "description": "Liveness and identity of the running Core.",
      "type": "object",
      "properties": {
        "method": {
          "type": "string",
          "const": "status"
        },
        "params": {
          "$ref": "#/$defs/StatusParams"
        }
      },
      "required": [
        "method",
        "params"
      ]
    },
    {
      "description": "Starts recording. In M1 this is the Operator's explicit act; from M2\nAuto-Record calls the same path.",
      "type": "object",
      "properties": {
        "method": {
          "type": "string",
          "const": "meeting/start"
        },
        "params": {
          "$ref": "#/$defs/MeetingStartParams"
        }
      },
      "required": [
        "method",
        "params"
      ]
    },
    {
      "description": "Stops the Meeting in progress and persists it.",
      "type": "object",
      "properties": {
        "method": {
          "type": "string",
          "const": "meeting/stop"
        },
        "params": {
          "$ref": "#/$defs/MeetingStopParams"
        }
      },
      "required": [
        "method",
        "params"
      ]
    },
    {
      "description": "Most recent Meetings first.",
      "type": "object",
      "properties": {
        "method": {
          "type": "string",
          "const": "meeting/list"
        },
        "params": {
          "$ref": "#/$defs/MeetingListParams"
        }
      },
      "required": [
        "method",
        "params"
      ]
    },
    {
      "description": "One Meeting with its Transcript.",
      "type": "object",
      "properties": {
        "method": {
          "type": "string",
          "const": "meeting/get"
        },
        "params": {
          "$ref": "#/$defs/MeetingGetParams"
        }
      },
      "required": [
        "method",
        "params"
      ]
    },
    {
      "description": "Renames a Meeting. The Mirror follows, and the old filename is\ngarbage-collected by its id8 (ADR-0035).",
      "type": "object",
      "properties": {
        "method": {
          "type": "string",
          "const": "meeting/retitle"
        },
        "params": {
          "$ref": "#/$defs/MeetingRetitleParams"
        }
      },
      "required": [
        "method",
        "params"
      ]
    },
    {
      "description": "Removes a Meeting entirely — rows, Mirror, and audio. The only\ndestructive operation on the record besides Voiceprint deletion.",
      "type": "object",
      "properties": {
        "method": {
          "type": "string",
          "const": "meeting/delete"
        },
        "params": {
          "$ref": "#/$defs/MeetingDeleteParams"
        }
      },
      "required": [
        "method",
        "params"
      ]
    },
    {
      "description": "The Meeting's Mirror markdown, exactly as written to disk.",
      "type": "object",
      "properties": {
        "method": {
          "type": "string",
          "const": "meeting/export"
        },
        "params": {
          "$ref": "#/$defs/MeetingGetParams"
        }
      },
      "required": [
        "method",
        "params"
      ]
    },
    {
      "description": "Full-text search across History.",
      "type": "object",
      "properties": {
        "method": {
          "type": "string",
          "const": "history/search"
        },
        "params": {
          "$ref": "#/$defs/HistorySearchParams"
        }
      },
      "required": [
        "method",
        "params"
      ]
    }
  ],
  "$defs": {
    "ClientCapabilities": {
      "type": "object",
      "properties": {
        "experimentalApi": {
          "description": "Opts the connection into methods marked experimental. Off by default,\nso a stable Client never sees an unstable surface.",
          "type": "boolean",
          "default": false
        }
      }
    },
    "ClientInfo": {
      "description": "Who is connecting. Recorded in Core logs; never leaves the machine.",
      "type": "object",
      "properties": {
        "name": {
          "type": "string"
        },
        "version": {
          "type": "string"
        }
      },
      "required": [
        "name",
        "version"
      ]
    },
    "HistorySearchParams": {
      "type": "object",
      "properties": {
        "limit": {
          "type": [
            "integer",
            "null"
          ],
          "format": "uint32",
          "minimum": 0
        },
        "query": {
          "type": "string"
        }
      },
      "required": [
        "query"
      ]
    },
    "InitializeParams": {
      "type": "object",
      "properties": {
        "capabilities": {
          "$ref": "#/$defs/ClientCapabilities",
          "default": {
            "experimentalApi": false
          }
        },
        "clientInfo": {
          "$ref": "#/$defs/ClientInfo"
        }
      },
      "required": [
        "clientInfo"
      ]
    },
    "MeetingDeleteParams": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string"
        }
      },
      "required": [
        "id"
      ]
    },
    "MeetingGetParams": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string"
        }
      },
      "required": [
        "id"
      ]
    },
    "MeetingListParams": {
      "type": "object",
      "properties": {
        "limit": {
          "type": [
            "integer",
            "null"
          ],
          "format": "uint32",
          "minimum": 0
        },
        "offset": {
          "type": [
            "integer",
            "null"
          ],
          "format": "uint32",
          "minimum": 0
        }
      }
    },
    "MeetingRetitleParams": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string"
        },
        "title": {
          "type": "string"
        }
      },
      "required": [
        "id",
        "title"
      ]
    },
    "MeetingStartParams": {
      "type": "object",
      "properties": {
        "detectedApp": {
          "type": [
            "string",
            "null"
          ]
        },
        "title": {
          "type": [
            "string",
            "null"
          ]
        }
      }
    },
    "MeetingStopParams": {
      "type": "object"
    },
    "StatusParams": {
      "type": "object"
    }
  }
}
