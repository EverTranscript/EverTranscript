{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "ClientRequest",
  "description": "Every request a Client may send the Core.",
  "oneOf": [
    {
      "description": "Opens the connection. Must be the first request; every other request\nbefore it is refused with `NOT_INITIALIZED`.",
      "type": "object",
      "properties": {
        "method": {
          "type": "string",
          "const": "initialize"
        },
        "params": {
          "$ref": "#/$defs/InitializeParams"
        }
      },
      "required": [
        "method",
        "params"
      ]
    },
    {
      "description": "Liveness and identity of the running Core.",
      "type": "object",
      "properties": {
        "method": {
          "type": "string",
          "const": "status"
        },
        "params": {
          "$ref": "#/$defs/StatusParams"
        }
      },
      "required": [
        "method",
        "params"
      ]
    },
    {
      "description": "Starts recording. In M1 this is the Operator's explicit act; from M2\nAuto-Record calls the same path.",
      "type": "object",
      "properties": {
        "method": {
          "type": "string",
          "const": "meeting/start"
        },
        "params": {
          "$ref": "#/$defs/MeetingStartParams"
        }
      },
      "required": [
        "method",
        "params"
      ]
    },
    {
      "description": "Stops the Meeting in progress and persists it.",
      "type": "object",
      "properties": {
        "method": {
          "type": "string",
          "const": "meeting/stop"
        },
        "params": {
          "$ref": "#/$defs/MeetingStopParams"
        }
      },
      "required": [
        "method",
        "params"
      ]
    },
    {
      "description": "Most recent Meetings first.",
      "type": "object",
      "properties": {
        "method": {
          "type": "string",
          "const": "meeting/list"
        },
        "params": {
          "$ref": "#/$defs/MeetingListParams"
        }
      },
      "required": [
        "method",
        "params"
      ]
    },
    {
      "description": "One Meeting with its Transcript.",
      "type": "object",
      "properties": {
        "method": {
          "type": "string",
          "const": "meeting/get"
        },
        "params": {
          "$ref": "#/$defs/MeetingGetParams"
        }
      },
      "required": [
        "method",
        "params"
      ]
    },
    {
      "description": "Renames a Meeting. The Mirror follows, and the old filename is\ngarbage-collected by its id8 (ADR-0035).",
      "type": "object",
      "properties": {
        "method": {
          "type": "string",
          "const": "meeting/retitle"
        },
        "params": {
          "$ref": "#/$defs/MeetingRetitleParams"
        }
      },
      "required": [
        "method",
        "params"
      ]
    },
    {
      "description": "Removes a Meeting entirely — rows, Mirror, and audio. The only\ndestructive operation on the record besides Voiceprint deletion.",
      "type": "object",
      "properties": {
        "method": {
          "type": "string",
          "const": "meeting/delete"
        },
        "params": {
          "$ref": "#/$defs/MeetingDeleteParams"
        }
      },
      "required": [
        "method",
        "params"
      ]
    },
    {
      "description": "The Meeting's Mirror markdown, exactly as written to disk.",
      "type": "object",
      "properties": {
        "method": {
          "type": "string",
          "const": "meeting/export"
        },
        "params": {
          "$ref": "#/$defs/MeetingGetParams"
        }
      },
      "required": [
        "method",
        "params"
      ]
    },
    {
      "description": "Full-text search across History.",
      "type": "object",
      "properties": {
        "method": {
          "type": "string",
          "const": "history/search"
        },
        "params": {
          "$ref": "#/$defs/HistorySearchParams"
        }
      },
      "required": [
        "method",
        "params"
      ]
    },
    {
      "description": "What the Core has on disk and what it still needs.",
      "type": "object",
      "properties": {
        "method": {
          "type": "string",
          "const": "models/status"
        },
        "params": {
          "$ref": "#/$defs/ModelsStatusParams"
        }
      },
      "required": [
        "method",
        "params"
      ]
    },
    {
      "description": "Downloads missing models. Returns once they are verified in place.",
      "type": "object",
      "properties": {
        "method": {
          "type": "string",
          "const": "models/fetch"
        },
        "params": {
          "$ref": "#/$defs/ModelsFetchParams"
        }
      },
      "required": [
        "method",
        "params"
      ]
    },
    {
      "description": "Subscribes to live captions and returns the transcript so far, in one\ncall.\n\nSnapshot and subscription together on purpose: fetching the\ntranscript and then subscribing leaves a window where a segment\ncompletes between the two and is lost from the Client's view forever\n(ADR-0028, snapshot-then-tail).",
      "type": "object",
      "properties": {
        "method": {
          "type": "string",
          "const": "transcript/subscribe"
        },
        "params": {
          "$ref": "#/$defs/TranscriptSubscribeParams"
        }
      },
      "required": [
        "method",
        "params"
      ]
    },
    {
      "description": "Stops caption delivery for this connection.",
      "type": "object",
      "properties": {
        "method": {
          "type": "string",
          "const": "transcript/unsubscribe"
        },
        "params": {
          "$ref": "#/$defs/TranscriptUnsubscribeParams"
        }
      },
      "required": [
        "method",
        "params"
      ]
    },
    {
      "description": "This installation's settings.",
      "type": "object",
      "properties": {
        "method": {
          "type": "string",
          "const": "settings/get"
        },
        "params": {
          "$ref": "#/$defs/SettingsGetParams"
        }
      },
      "required": [
        "method",
        "params"
      ]
    },
    {
      "description": "Changes settings. Every field is optional; omitted fields are left\nalone, so a Client can toggle one thing without echoing the rest.",
      "type": "object",
      "properties": {
        "method": {
          "type": "string",
          "const": "settings/set"
        },
        "params": {
          "$ref": "#/$defs/SettingsSetParams"
        }
      },
      "required": [
        "method",
        "params"
      ]
    }
  ],
  "$defs": {
    "ChineseScript": {
      "description": "Which Han script to write Mandarin in.\n\nTranscription stays on automatic language detection, because meetings\ncode-switch (story 7) — so the script the model returns is whatever its\ntraining data favoured, not what the speaker would have written. Left\nalone it is frequently Traditional even for a Simplified speaker, which\nthe dogfood run measured. This is the Operator saying which one their\nrecord should use; it is an orthographic choice, not a translation, and\nthe words are identical either way.",
      "oneOf": [
        {
          "type": "string",
          "enum": [
            "traditional"
          ]
        },
        {
          "description": "The default: more people read it than any other Han script.",
          "type": "string",
          "const": "simplified"
        }
      ]
    },
    "ClientCapabilities": {
      "type": "object",
      "properties": {
        "experimentalApi": {
          "description": "Opts the connection into methods marked experimental. Off by default,\nso a stable Client never sees an unstable surface.",
          "type": "boolean",
          "default": false
        }
      }
    },
    "ClientInfo": {
      "description": "Who is connecting. Recorded in Core logs; never leaves the machine.",
      "type": "object",
      "properties": {
        "name": {
          "type": "string"
        },
        "version": {
          "type": "string"
        }
      },
      "required": [
        "name",
        "version"
      ]
    },
    "HistorySearchParams": {
      "type": "object",
      "properties": {
        "limit": {
          "type": [
            "integer",
            "null"
          ],
          "format": "uint32",
          "minimum": 0
        },
        "query": {
          "type": "string"
        }
      },
      "required": [
        "query"
      ]
    },
    "InitializeParams": {
      "type": "object",
      "properties": {
        "capabilities": {
          "$ref": "#/$defs/ClientCapabilities",
          "default": {
            "experimentalApi": false
          }
        },
        "clientInfo": {
          "$ref": "#/$defs/ClientInfo"
        }
      },
      "required": [
        "clientInfo"
      ]
    },
    "MeetingDeleteParams": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string"
        }
      },
      "required": [
        "id"
      ]
    },
    "MeetingGetParams": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string"
        }
      },
      "required": [
        "id"
      ]
    },
    "MeetingListParams": {
      "type": "object",
      "properties": {
        "limit": {
          "type": [
            "integer",
            "null"
          ],
          "format": "uint32",
          "minimum": 0
        },
        "offset": {
          "type": [
            "integer",
            "null"
          ],
          "format": "uint32",
          "minimum": 0
        }
      }
    },
    "MeetingRetitleParams": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string"
        },
        "title": {
          "type": "string"
        }
      },
      "required": [
        "id",
        "title"
      ]
    },
    "MeetingStartParams": {
      "type": "object",
      "properties": {
        "detectedApp": {
          "type": [
            "string",
            "null"
          ]
        },
        "title": {
          "type": [
            "string",
            "null"
          ]
        }
      }
    },
    "MeetingStopParams": {
      "type": "object"
    },
    "ModelsFetchParams": {
      "type": "object",
      "properties": {
        "key": {
          "description": "Fetch one model by key; omit to fetch everything required.",
          "type": [
            "string",
            "null"
          ]
        }
      }
    },
    "ModelsStatusParams": {
      "type": "object"
    },
    "SettingsGetParams": {
      "type": "object"
    },
    "SettingsSetParams": {
      "type": "object",
      "properties": {
        "autoRecord": {
          "type": [
            "boolean",
            "null"
          ]
        },
        "briefingAcknowledged": {
          "description": "Records that the Operator acknowledged the Briefing. Once true it is\nnever set back to false by a Client: un-acknowledging consent is not\na thing that happens, and allowing it would make the pre-capture\ninvariant a toggle.",
          "type": [
            "boolean",
            "null"
          ]
        },
        "chineseScript": {
          "description": "Which Han script Mandarin is written in. See [`ChineseScript`].",
          "anyOf": [
            {
              "$ref": "#/$defs/ChineseScript"
            },
            {
              "type": "null"
            }
          ]
        },
        "launchAtLogin": {
          "description": "Registration only — this changes the *next* login and leaves a\nrunning Core alone (story 9c).",
          "type": [
            "boolean",
            "null"
          ]
        }
      }
    },
    "StatusParams": {
      "type": "object"
    },
    "TranscriptSubscribeParams": {
      "type": "object",
      "properties": {
        "meetingId": {
          "description": "Which Meeting to follow. Omit for the one currently recording.",
          "type": [
            "string",
            "null"
          ]
        }
      }
    },
    "TranscriptUnsubscribeParams": {
      "type": "object"
    }
  }
}
