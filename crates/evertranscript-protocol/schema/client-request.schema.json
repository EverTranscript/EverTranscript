{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "ClientRequest",
  "description": "Every request a Client may send the Core.",
  "oneOf": [
    {
      "description": "Opens the connection. Must be the first request; every other request\nbefore it is refused with `NOT_INITIALIZED`.",
      "type": "object",
      "properties": {
        "method": {
          "type": "string",
          "const": "initialize"
        },
        "params": {
          "$ref": "#/$defs/InitializeParams"
        }
      },
      "required": [
        "method",
        "params"
      ]
    },
    {
      "description": "Liveness and identity of the running Core.",
      "type": "object",
      "properties": {
        "method": {
          "type": "string",
          "const": "status"
        },
        "params": {
          "$ref": "#/$defs/StatusParams"
        }
      },
      "required": [
        "method",
        "params"
      ]
    },
    {
      "description": "Starts recording. In M1 this is the Operator's explicit act; from M2\nAuto-Record calls the same path.",
      "type": "object",
      "properties": {
        "method": {
          "type": "string",
          "const": "meeting/start"
        },
        "params": {
          "$ref": "#/$defs/MeetingStartParams"
        }
      },
      "required": [
        "method",
        "params"
      ]
    },
    {
      "description": "Stops the Meeting in progress and persists it.",
      "type": "object",
      "properties": {
        "method": {
          "type": "string",
          "const": "meeting/stop"
        },
        "params": {
          "$ref": "#/$defs/MeetingStopParams"
        }
      },
      "required": [
        "method",
        "params"
      ]
    },
    {
      "description": "Most recent Meetings first.",
      "type": "object",
      "properties": {
        "method": {
          "type": "string",
          "const": "meeting/list"
        },
        "params": {
          "$ref": "#/$defs/MeetingListParams"
        }
      },
      "required": [
        "method",
        "params"
      ]
    },
    {
      "description": "One Meeting with its Transcript.",
      "type": "object",
      "properties": {
        "method": {
          "type": "string",
          "const": "meeting/get"
        },
        "params": {
          "$ref": "#/$defs/MeetingGetParams"
        }
      },
      "required": [
        "method",
        "params"
      ]
    },
    {
      "description": "Renames a Meeting. The Mirror follows, and the old filename is\ngarbage-collected by its id8 (ADR-0035).",
      "type": "object",
      "properties": {
        "method": {
          "type": "string",
          "const": "meeting/retitle"
        },
        "params": {
          "$ref": "#/$defs/MeetingRetitleParams"
        }
      },
      "required": [
        "method",
        "params"
      ]
    },
    {
      "description": "Removes a Meeting entirely — rows, Mirror, and audio. The only\ndestructive operation on the record besides Voiceprint deletion.",
      "type": "object",
      "properties": {
        "method": {
          "type": "string",
          "const": "meeting/delete"
        },
        "params": {
          "$ref": "#/$defs/MeetingDeleteParams"
        }
      },
      "required": [
        "method",
        "params"
      ]
    },
    {
      "description": "The Meeting's Mirror markdown, exactly as written to disk.",
      "type": "object",
      "properties": {
        "method": {
          "type": "string",
          "const": "meeting/export"
        },
        "params": {
          "$ref": "#/$defs/MeetingGetParams"
        }
      },
      "required": [
        "method",
        "params"
      ]
    },
    {
      "description": "Full-text search across History.",
      "type": "object",
      "properties": {
        "method": {
          "type": "string",
          "const": "history/search"
        },
        "params": {
          "$ref": "#/$defs/HistorySearchParams"
        }
      },
      "required": [
        "method",
        "params"
      ]
    },
    {
      "description": "Records for a few seconds and reports what actually arrived.\n\nA question about permission that is answered by recording rather than\nby asking, because on macOS asking does not work: the system-audio tap\nis granted whether or not capture was allowed, and a refused one\ndelivers silence forever without ever failing. The Core is the process\nthat records in production, so it is the process that must be asked —\nwhich is why this is a request rather than something the Client could\ndo for itself with `getUserMedia`.",
      "type": "object",
      "properties": {
        "method": {
          "type": "string",
          "const": "audio/check"
        },
        "params": {
          "$ref": "#/$defs/AudioCheckParams"
        }
      },
      "required": [
        "method",
        "params"
      ]
    },
    {
      "description": "What the Core has on disk and what it still needs.",
      "type": "object",
      "properties": {
        "method": {
          "type": "string",
          "const": "models/status"
        },
        "params": {
          "$ref": "#/$defs/ModelsStatusParams"
        }
      },
      "required": [
        "method",
        "params"
      ]
    },
    {
      "description": "Downloads missing models. Returns once they are verified in place.",
      "type": "object",
      "properties": {
        "method": {
          "type": "string",
          "const": "models/fetch"
        },
        "params": {
          "$ref": "#/$defs/ModelsFetchParams"
        }
      },
      "required": [
        "method",
        "params"
      ]
    },
    {
      "description": "Stops a fetch in progress. What is on disk stays, so asking again\nresumes rather than restarting.",
      "type": "object",
      "properties": {
        "method": {
          "type": "string",
          "const": "models/cancel"
        },
        "params": {
          "$ref": "#/$defs/ModelsCancelParams"
        }
      },
      "required": [
        "method",
        "params"
      ]
    },
    {
      "description": "Subscribes to live captions and returns the transcript so far, in one\ncall.\n\nSnapshot and subscription together on purpose: fetching the\ntranscript and then subscribing leaves a window where a segment\ncompletes between the two and is lost from the Client's view forever\n(ADR-0028, snapshot-then-tail).",
      "type": "object",
      "properties": {
        "method": {
          "type": "string",
          "const": "transcript/subscribe"
        },
        "params": {
          "$ref": "#/$defs/TranscriptSubscribeParams"
        }
      },
      "required": [
        "method",
        "params"
      ]
    },
    {
      "description": "Stops caption delivery for this connection.",
      "type": "object",
      "properties": {
        "method": {
          "type": "string",
          "const": "transcript/unsubscribe"
        },
        "params": {
          "$ref": "#/$defs/TranscriptUnsubscribeParams"
        }
      },
      "required": [
        "method",
        "params"
      ]
    },
    {
      "description": "This installation's settings.",
      "type": "object",
      "properties": {
        "method": {
          "type": "string",
          "const": "settings/get"
        },
        "params": {
          "$ref": "#/$defs/SettingsGetParams"
        }
      },
      "required": [
        "method",
        "params"
      ]
    },
    {
      "description": "Changes settings. Every field is optional; omitted fields are left\nalone, so a Client can toggle one thing without echoing the rest.",
      "type": "object",
      "properties": {
        "method": {
          "type": "string",
          "const": "settings/set"
        },
        "params": {
          "$ref": "#/$defs/SettingsSetParams"
        }
      },
      "required": [
        "method",
        "params"
      ]
    },
    {
      "description": "What Meeting Detection watches on this machine, and what it offers.",
      "type": "object",
      "properties": {
        "method": {
          "type": "string",
          "const": "watchlist/get"
        },
        "params": {
          "$ref": "#/$defs/WatchlistGetParams"
        }
      },
      "required": [
        "method",
        "params"
      ]
    },
    {
      "description": "Adds an app to the Watchlist. Membership is the per-app switch\n(ADR-0030): there is no enable flag to set afterwards.",
      "type": "object",
      "properties": {
        "method": {
          "type": "string",
          "const": "watchlist/add"
        },
        "params": {
          "$ref": "#/$defs/WatchlistAddParams"
        }
      },
      "required": [
        "method",
        "params"
      ]
    },
    {
      "description": "Removes an app from the Watchlist.",
      "type": "object",
      "properties": {
        "method": {
          "type": "string",
          "const": "watchlist/remove"
        },
        "params": {
          "$ref": "#/$defs/WatchlistRemoveParams"
        }
      },
      "required": [
        "method",
        "params"
      ]
    },
    {
      "description": "Replaces a Meeting's Notes. ADR-0018: the Operator's own writing,\neditable during the call and forever after.",
      "type": "object",
      "properties": {
        "method": {
          "type": "string",
          "const": "meeting/setNotes"
        },
        "params": {
          "$ref": "#/$defs/MeetingSetNotesParams"
        }
      },
      "required": [
        "method",
        "params"
      ]
    },
    {
      "description": "Generates a Summary for a finished Meeting, on the chosen Backend.",
      "type": "object",
      "properties": {
        "method": {
          "type": "string",
          "const": "summary/generate"
        },
        "params": {
          "$ref": "#/$defs/MeetingGetParams"
        }
      },
      "required": [
        "method",
        "params"
      ]
    },
    {
      "description": "The Summary Backends this build offers, and what is known about each.",
      "type": "object",
      "properties": {
        "method": {
          "type": "string",
          "const": "summary/backends"
        },
        "params": {
          "$ref": "#/$defs/SummaryBackendsParams"
        }
      },
      "required": [
        "method",
        "params"
      ]
    },
    {
      "description": "Stores an API key in the OS credential store. **Never readable\nback** — a Client may ask whether one exists and replace or clear it,\nand that is all (story 41).",
      "type": "object",
      "properties": {
        "method": {
          "type": "string",
          "const": "summary/setKey"
        },
        "params": {
          "$ref": "#/$defs/SummarySetKeyParams"
        }
      },
      "required": [
        "method",
        "params"
      ]
    },
    {
      "description": "The one-time Briefing (ADR-0007). Readable again after\nacknowledgment: an Operator who wants to re-read what they agreed to\nshould not have to reinstall.",
      "type": "object",
      "properties": {
        "method": {
          "type": "string",
          "const": "briefing/get"
        },
        "params": {
          "$ref": "#/$defs/BriefingGetParams"
        }
      },
      "required": [
        "method",
        "params"
      ]
    },
    {
      "description": "What this installation holds, what it may say on the wire, and what\nit cannot do (stories 46, 47). Enumerated so it can be checked.",
      "type": "object",
      "properties": {
        "method": {
          "type": "string",
          "const": "posture/get"
        },
        "params": {
          "$ref": "#/$defs/PostureGetParams"
        }
      },
      "required": [
        "method",
        "params"
      ]
    },
    {
      "description": "Every Speaker the app holds — the Voice Registry's inventory\n(story 30). ADR-0008 makes this surface mandatory rather than\noptional: it is half of what was traded for storing Voiceprints\nat all.",
      "type": "object",
      "properties": {
        "method": {
          "type": "string",
          "const": "speaker/list"
        },
        "params": {
          "$ref": "#/$defs/SpeakerListParams"
        }
      },
      "required": [
        "method",
        "params"
      ]
    },
    {
      "description": "One Speaker, with the facts a person needs to act on it.",
      "type": "object",
      "properties": {
        "method": {
          "type": "string",
          "const": "speaker/get"
        },
        "params": {
          "$ref": "#/$defs/SpeakerGetParams"
        }
      },
      "required": [
        "method",
        "params"
      ]
    },
    {
      "description": "Names a Speaker, which also confirms its Voiceprint (ADR-0008 as\namended). Retroactive across all of History by construction — the\nrecord holds references, not names (story 29).",
      "type": "object",
      "properties": {
        "method": {
          "type": "string",
          "const": "speaker/rename"
        },
        "params": {
          "$ref": "#/$defs/SpeakerRenameParams"
        }
      },
      "required": [
        "method",
        "params"
      ]
    },
    {
      "description": "Deletes a Speaker's Voiceprint (story 31). Recognition stops; the\nrecord is untouched. The only destructive biometric operation there\nis (ADR-0009) — the Speaker itself is permanent.",
      "type": "object",
      "properties": {
        "method": {
          "type": "string",
          "const": "speaker/deleteVoiceprint"
        },
        "params": {
          "$ref": "#/$defs/SpeakerGetParams"
        }
      },
      "required": [
        "method",
        "params"
      ]
    },
    {
      "description": "Re-assigns a segment to a different Speaker (story 29b). Appends a\nhint; the machine's attribution is preserved beneath it.",
      "type": "object",
      "properties": {
        "method": {
          "type": "string",
          "const": "transcript/reassign"
        },
        "params": {
          "$ref": "#/$defs/TranscriptReassignParams"
        }
      },
      "required": [
        "method",
        "params"
      ]
    },
    {
      "description": "What Diarization is doing, if anything.",
      "type": "object",
      "properties": {
        "method": {
          "type": "string",
          "const": "diarize/status"
        },
        "params": {
          "$ref": "#/$defs/DiarizeStatusParams"
        }
      },
      "required": [
        "method",
        "params"
      ]
    },
    {
      "description": "Diarizes a finished Meeting, or re-diarizes one.\n\nRe-running replaces the machine's attribution and preserves every\nOperator correction (ADR-0009 as amended) — which is what makes a\nmodel upgrade safe to apply to a History that has been corrected.",
      "type": "object",
      "properties": {
        "method": {
          "type": "string",
          "const": "diarize/run"
        },
        "params": {
          "$ref": "#/$defs/DiarizeCancelParams"
        }
      },
      "required": [
        "method",
        "params"
      ]
    },
    {
      "description": "Stops a running Diarization. Whatever attribution completed is kept;\na job the Operator cannot stop is an unaccountable use of their\nmachine.",
      "type": "object",
      "properties": {
        "method": {
          "type": "string",
          "const": "diarize/cancel"
        },
        "params": {
          "$ref": "#/$defs/DiarizeCancelParams"
        }
      },
      "required": [
        "method",
        "params"
      ]
    }
  ],
  "$defs": {
    "AudioCheckParams": {
      "type": "object",
      "properties": {
        "seconds": {
          "description": "How long to listen. Longer is more conclusive: a refused system-audio\npermission looks exactly like nobody talking until enough has been\nplayed to prove otherwise.",
          "type": [
            "integer",
            "null"
          ],
          "format": "uint64",
          "minimum": 0
        }
      }
    },
    "BriefingGetParams": {
      "type": "object",
      "properties": {
        "language": {
          "description": "`en` or `zh`. Defaults to English, because a translated legal notice\nshown by accident is worse than an English one shown on purpose.",
          "type": [
            "string",
            "null"
          ]
        }
      }
    },
    "ChineseScript": {
      "description": "Which Han script to write Mandarin in.\n\nTranscription stays on automatic language detection, because meetings\ncode-switch (story 7) — so the script the model returns is whatever its\ntraining data favoured, not what the speaker would have written. Left\nalone it is frequently Traditional even for a Simplified speaker, which\nthe dogfood run measured. This is the Operator saying which one their\nrecord should use; it is an orthographic choice, not a translation, and\nthe words are identical either way.",
      "oneOf": [
        {
          "type": "string",
          "enum": [
            "traditional"
          ]
        },
        {
          "description": "The default: more people read it than any other Han script.",
          "type": "string",
          "const": "simplified"
        }
      ]
    },
    "ClientCapabilities": {
      "type": "object",
      "properties": {
        "experimentalApi": {
          "description": "Opts the connection into methods marked experimental. Off by default,\nso a stable Client never sees an unstable surface.",
          "type": "boolean",
          "default": false
        }
      }
    },
    "ClientInfo": {
      "description": "Who is connecting. Recorded in Core logs; never leaves the machine.",
      "type": "object",
      "properties": {
        "name": {
          "type": "string"
        },
        "version": {
          "type": "string"
        }
      },
      "required": [
        "name",
        "version"
      ]
    },
    "DiarizeCancelParams": {
      "type": "object",
      "properties": {
        "meetingId": {
          "type": "string"
        }
      },
      "required": [
        "meetingId"
      ]
    },
    "DiarizeStatusParams": {
      "type": "object"
    },
    "HistorySearchParams": {
      "type": "object",
      "properties": {
        "limit": {
          "type": [
            "integer",
            "null"
          ],
          "format": "uint32",
          "minimum": 0
        },
        "query": {
          "type": "string"
        }
      },
      "required": [
        "query"
      ]
    },
    "InitializeParams": {
      "type": "object",
      "properties": {
        "capabilities": {
          "$ref": "#/$defs/ClientCapabilities",
          "default": {
            "experimentalApi": false
          }
        },
        "clientInfo": {
          "$ref": "#/$defs/ClientInfo"
        }
      },
      "required": [
        "clientInfo"
      ]
    },
    "MeetingDeleteParams": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string"
        }
      },
      "required": [
        "id"
      ]
    },
    "MeetingGetParams": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string"
        }
      },
      "required": [
        "id"
      ]
    },
    "MeetingListParams": {
      "type": "object",
      "properties": {
        "limit": {
          "type": [
            "integer",
            "null"
          ],
          "format": "uint32",
          "minimum": 0
        },
        "offset": {
          "type": [
            "integer",
            "null"
          ],
          "format": "uint32",
          "minimum": 0
        }
      }
    },
    "MeetingRetitleParams": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string"
        },
        "title": {
          "type": "string"
        }
      },
      "required": [
        "id",
        "title"
      ]
    },
    "MeetingSetNotesParams": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string"
        },
        "notes": {
          "description": "Markdown. Replaces whatever was there — Notes are the Operator's, and\na merge would be the product having an opinion about their writing.",
          "type": "string"
        }
      },
      "required": [
        "id",
        "notes"
      ]
    },
    "MeetingStartParams": {
      "type": "object",
      "properties": {
        "detectedApp": {
          "type": [
            "string",
            "null"
          ]
        },
        "title": {
          "type": [
            "string",
            "null"
          ]
        }
      }
    },
    "MeetingStopParams": {
      "type": "object"
    },
    "ModelsCancelParams": {
      "type": "object"
    },
    "ModelsFetchParams": {
      "type": "object",
      "properties": {
        "key": {
          "description": "Fetch one model by key; omit to fetch everything required.",
          "type": [
            "string",
            "null"
          ]
        }
      }
    },
    "ModelsStatusParams": {
      "type": "object"
    },
    "PostureGetParams": {
      "type": "object"
    },
    "SettingsGetParams": {
      "type": "object"
    },
    "SettingsSetParams": {
      "type": "object",
      "properties": {
        "autoRecord": {
          "type": [
            "boolean",
            "null"
          ]
        },
        "briefingAcknowledged": {
          "description": "Records that the Operator acknowledged the Briefing. Once true it is\nnever set back to false by a Client: un-acknowledging consent is not\na thing that happens, and allowing it would make the pre-capture\ninvariant a toggle.",
          "type": [
            "boolean",
            "null"
          ]
        },
        "checkForUpdates": {
          "type": [
            "boolean",
            "null"
          ]
        },
        "chineseScript": {
          "description": "Which Han script Mandarin is written in. See [`ChineseScript`].",
          "anyOf": [
            {
              "$ref": "#/$defs/ChineseScript"
            },
            {
              "type": "null"
            }
          ]
        },
        "launchAtLogin": {
          "description": "Registration only — this changes the *next* login and leaves a\nrunning Core alone (story 9c).",
          "type": [
            "boolean",
            "null"
          ]
        },
        "summaryBackend": {
          "description": "`local`, a preset id, or a custom endpoint id. Setting it to a cloud\ndestination is refused until the warning has been accepted.",
          "type": [
            "string",
            "null"
          ]
        },
        "summaryBaseUrl": {
          "type": [
            "string",
            "null"
          ]
        },
        "summaryCloudWarningAccepted": {
          "description": "Set once the Operator has been shown what leaves the machine\n(story 36).",
          "type": [
            "boolean",
            "null"
          ]
        },
        "summaryPrompt": {
          "description": "The system prompt. An empty string resets to the default (story 42),\nwhich keeps reset a deletion rather than a copy that could drift.",
          "type": [
            "string",
            "null"
          ]
        },
        "summaryStrict": {
          "type": [
            "boolean",
            "null"
          ]
        }
      }
    },
    "SpeakerGetParams": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string"
        }
      },
      "required": [
        "id"
      ]
    },
    "SpeakerListParams": {
      "type": "object"
    },
    "SpeakerRenameParams": {
      "type": "object",
      "properties": {
        "displayName": {
          "type": "string"
        },
        "id": {
          "type": "string"
        }
      },
      "required": [
        "id",
        "displayName"
      ]
    },
    "StatusParams": {
      "type": "object"
    },
    "SummaryBackendsParams": {
      "type": "object"
    },
    "SummarySetKeyParams": {
      "type": "object",
      "properties": {
        "key": {
          "description": "None clears the stored key. Clearing is a first-class act, not a side\neffect of switching the Knob.",
          "type": [
            "string",
            "null"
          ]
        },
        "provider": {
          "type": "string"
        }
      },
      "required": [
        "provider"
      ]
    },
    "TranscriptReassignParams": {
      "type": "object",
      "properties": {
        "segmentId": {
          "type": "string"
        },
        "speakerId": {
          "type": "string"
        }
      },
      "required": [
        "segmentId",
        "speakerId"
      ]
    },
    "TranscriptSubscribeParams": {
      "type": "object",
      "properties": {
        "meetingId": {
          "description": "Which Meeting to follow. Omit for the one currently recording.",
          "type": [
            "string",
